# ============================================================
#  环境变量示例文件
#
#  使用方法：
#     cp .env.example .env
#     然后把下面的值改成你自己的
#
#  ⚠️ .env 里是真实密钥，绝对不能提交到 Git（已在 .gitignore 中排除）
#  ⚠️ 这个 .env.example 只放"占位符"，可以安全提交
# ============================================================

# ---------- 运行模式 ----------
# 是否在错误响应里返回详细堆栈（traceback）
#   开发环境：true（方便排查）
#   ★ 生产环境：必须 false（否则会泄露文件路径、SQL、依赖版本）
DEBUG=false


# ---------- 数据库 ----------
# 格式：mysql+aiomysql://用户名:密码@主机:端口/库名?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/news_app?charset=utf8mb4

# 是否打印 SQL 日志（开发时 true 方便调试，上线建议 false）
DB_ECHO=true


# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0


# ---------- AI 服务 ----------
# 任何"OpenAI 兼容"的服务都可以：阿里云百炼、DeepSeek、各类中转站……
# 三个值都要换成你自己账号的
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://your-ai-provider.example.com/v1
AI_MODEL=your-model-name


# ---------- AI 限流 / 历史 ----------
# 每个用户每 AI_RATE_WINDOW 秒最多请求 AI_RATE_LIMIT 次
AI_RATE_LIMIT=10
AI_RATE_WINDOW=60
# 每次请求携带的最近对话轮数（越大越贵，也越容易超出模型上下文限制）
AI_HISTORY_LIMIT=10
